# identity・アカウント固有の設定は ~/.gitconfig.local で行う (Git 管理外)
# cp ~/dotfiles/git/.gitconfig.local.example ~/.gitconfig.local
# ※ include は「末尾」に置く。ここで上書きしたいので、下の credential 定義より後に読ませる。

[init]
	defaultBranch = main

[color]
	ui = auto

[core]
	autocrlf = input
	# excludesfile は未指定 → ~/.config/git/ignore が自動で使われる

[pager]
	branch = false
	diff = false

[http]
	postBuffer = 157286400

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# identity・アカウント固有の設定とディレクトリ別のアカウント切り替えは、すべて
# ~/.gitconfig.local (Git 管理外) に集約する。上の credential 定義より後に読ませる。
[include]
	path = ~/.gitconfig.local
